{
  "manifest_version": 3,
  "name": "iClicker Poll Notifier",
  "version": "0.1.0",
  "description": "Chrome notifications and optional sound alerts when a new iClicker page URL appears.",
  "minimum_chrome_version": "116",
  "permissions": [
    "webNavigation",
    "notifications",
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "https://student.iclicker.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "iClicker Poll Notifier",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
